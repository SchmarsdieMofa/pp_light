# pp_light behind an existing (company) reverse proxy that terminates HTTPS and forwards plain HTTP to port 80.
# Selected with PP_MODE=behind-proxy in .env. Caddy does no TLS and no HTTP→HTTPS redirect here –
# that redirect is what loops (ERR_TOO_MANY_REDIRECTS) when the proxy talks HTTP to us.
#
# PP_TRUSTED_PROXIES: address(es) of the company proxy, e.g. "10.1.2.3" or "10.1.2.0/24 10.1.3.4".
#   Only these may talk to pp_light, and only their X-Forwarded-For is believed (real client IP for the login lock).
#   Default private_ranges = every private network address – works, but then anyone in the network
#   can bypass the proxy and reach pp_light over plain HTTP. Set the real proxy address.
{
	auto_https off
	servers {
		trusted_proxies static {$PP_TRUSTED_PROXIES:private_ranges}
		# Read X-Forwarded-For from the right: only hops added by trusted proxies count, a client cannot fake its IP.
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

:80 {
	encode zstd gzip

	@direct not remote_ip {$PP_TRUSTED_PROXIES:private_ranges}
	respond @direct "Bitte über https://{$PP_DOMAIN} aufrufen." 403

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy app:3000 {
		# Users always come in over HTTPS at the proxy – the app must build https links and secure cookies.
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {$PP_DOMAIN}
		header_up Host {$PP_DOMAIN}
		# Exactly one hop: the client address Caddy worked out above. The app's login lock uses the first one.
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}
}
