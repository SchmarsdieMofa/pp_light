# HTTPS in front of pp_light, for the internal network only. PP_DOMAIN and PP_TLS come from .env.
#   PP_TLS=internal              Caddy's own CA (default, for the local network – clients must trust its root certificate)
#   PP_TLS=/certs/cert.pem /certs/key.pem   own certificate, e.g. from the company CA (mount ./certs, see README)
# Plain HTTP on port 80 redirects to HTTPS automatically.
{$PP_DOMAIN} {
	tls {$PP_TLS:internal}
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Caddy replaces X-Forwarded-For from clients with the real address, so the app's per-IP login lock cannot be dodged.
	reverse_proxy app:3000
}
