# App
DATABASE_URL=postgres://pp:pp@localhost:5432/pp_light
# Pflicht, mind. 32 Zeichen, zufällig: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Nur Entwicklung: Adresse für Links in Mails. In Produktion legt sie die Einrichtung fest (Einstellungen → Server).
APP_URL=http://localhost:3000
UPLOAD_MAX_MB=25
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=pp_light <no-reply@localhost>
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_PASS=                 # Alias; SMTP_PASSWORD hat Vorrang
# SMTP_SECURE=false          # Altbestand; nur ohne SMTP_TLS_MODE wirksam
# auto: STARTTLS falls angeboten; starttls/required: STARTTLS erzwingen
# ssl: implizites TLS (meist Port 465); none: Klartext, nur vertrauenswürdiges internes Netz
SMTP_TLS_MODE=auto
# false akzeptiert auch selbstsignierte/abgelaufene Zertifikate (unsicher)
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Zusätzliche interne CA (PEM), Pfad im Container; per Volume einbinden (README)
SMTP_TLS_CA_FILE=
# TLSv1.2 (Default), TLSv1.3; TLSv1.1/TLSv1 nur für Altsysteme
SMTP_TLS_MIN_VERSION=TLSv1.2
# OpenSSL-Cipher-String; leer = Node-Defaults. Notbehelf für DHE-1024: DEFAULT@SECLEVEL=0
SMTP_TLS_CIPHERS=

# Ausgehender HTTP(S)-Proxy für App/Worker; ohne Proxy leer lassen
# Beispiel: HTTP_PROXY=http://proxy.example.org:3128
HTTP_PROXY=
HTTPS_PROXY=
# Zusätzliche Hosts/Domains ohne Proxy, kommasepariert. Interne Dienste und Loopback
# (postgres, app, worker, caddy, backup, localhost, 127.0.0.1, ::1) sind immer ausgenommen.
# Beispiel: NO_PROXY_EXTRA=.intern.example.org,mail.example.org,10.0.0.1
# CIDR-Unterstützung hängt vom jeweiligen Client ab; für Node einzelne IPs/IP-Bereiche verwenden.
NO_PROXY_EXTRA=
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ALLOWED_DOMAINS=
# Nur für Provider ohne email_verified (z. B. Microsoft Entra ID, eigener Tenant):
# OIDC_TRUST_EMAIL=false

# Nur docker-compose.yml (Produktion)
# Name, unter der pp_light im Netz per HTTPS erreichbar ist (DNS-Eintrag auf den Server). Caddy stellt das Zertifikat dafür aus.
PP_DOMAIN=
# internal = eigene CA von Caddy (Root-Zertifikat auf den Clients verteilen, siehe README)
# oder eigenes Zertifikat: /certs/cert.pem /certs/key.pem (Dateien nach ./certs legen)
PP_TLS=internal
# Backups nach ./backups: täglich um BACKUP_HOUR Uhr, BACKUP_KEEP_DAYS Tage aufbewahren
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
# BACKUP_DIR=./backups
POSTGRES_USER=pp
# Nur Buchstaben/Ziffern (wird in DATABASE_URL eingesetzt)
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pp_light
