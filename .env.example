# App
DATABASE_URL=postgres://pp:pp@localhost:5432/pp_light
# Pflicht, mind. 32 Zeichen, zufällig: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true
APP_URL=http://localhost:3000
UPLOAD_MAX_MB=25
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=pp_light <no-reply@localhost>
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ALLOWED_DOMAINS=

# Nur docker-compose.yml (Produktion)
POSTGRES_USER=pp
# Nur Buchstaben/Ziffern (wird in DATABASE_URL eingesetzt)
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pp_light
